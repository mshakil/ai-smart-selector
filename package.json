{
  "name": "ai-selector-extension",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "start": "node apps/cli/dist/index.js start",
    "publish:packages": "node scripts/publish-all.mjs",
    "publish:dry-run": "node scripts/publish-all.mjs --dry-run",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.4.5",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}