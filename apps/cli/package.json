{
  "name": "smartlocator",
  "version": "0.1.0",
  "description": "AI-assisted selector intelligence for test automation engineers — capture elements, generate robust selectors, write POM code directly from the browser",
  "license": "MIT",
  "keywords": [
    "test-automation",
    "playwright",
    "cypress",
    "selector",
    "locator",
    "page-object-model",
    "ai",
    "chrome-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mshakil/ai-smart-selector.git"
  },
  "homepage": "https://github.com/mshakil/ai-smart-selector#readme",
  "type": "module",
  "bin": {
    "smartlocator": "./dist/index.js"
  },
  "files": [
    "dist/",
    "extension-dist/",
    "scripts/postinstall.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "build:all": "pnpm --filter smartlocator-extension build && node scripts/copy-extension.mjs && tsup",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts start",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build:all",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@smartlocator/shared": "workspace:*",
    "@smartlocator/ai-core": "workspace:*",
    "@smartlocator/engine": "workspace:*",
    "@anthropic-ai/sdk": "^0.24.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "glob": "^10.4.2",
    "openai": "^4.52.0",
    "ts-morph": "^23.0.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/ws": "^8.5.12",
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
