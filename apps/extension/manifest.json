{
  "manifest_version": 3,
  "name": "SmartLocator AI",
  "version": "0.1.0",
  "description": "AI-assisted selector intelligence for test automation engineers",
  "permissions": ["activeTab", "storage", "clipboardWrite", "alarms"],
  "host_permissions": ["http://localhost:3137/"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "SmartLocator AI"
  }
}
