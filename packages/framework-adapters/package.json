{
  "name": "@smartlocator/framework-adapters",
  "version": "0.1.0",
  "description": "Playwright and Cypress code generators for SmartLocator AI",
  "license": "MIT",
  "keywords": ["smartlocator", "playwright", "cypress", "test-automation", "locator"],
  "repository": {
    "type": "git",
