{
  "name": "@smartlocator/shared",
  "version": "0.1.5",
  "description": "Shared TypeScript types and WebSocket event contracts for SmartLocator AI",
  "license": "MIT",
  "keywords": [
    "smartlocator",
    "test-automation",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mshakil/ai-smart-selector.git",
    "directory": "packages/shared"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
