{
  "name": "@smartlocator/engine",
  "version": "0.1.4",
  "description": "AST analysis, POM scanning, code generation and patch lifecycle for SmartLocator AI",
  "license": "MIT",
  "keywords": [
    "smartlocator",
    "ast",
    "playwright",
    "cypress",
    "page-object-model",
    "test-automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mshakil/ai-smart-selector.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@smartlocator/shared": "workspace:*",
    "@smartlocator/framework-adapters": "workspace:*",
    "chokidar": "^3.6.0",
    "diff": "^5.2.0",
    "glob": "^10.4.2",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
