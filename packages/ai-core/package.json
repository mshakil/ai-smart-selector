{
  "name": "@smartlocator/ai-core",
  "version": "0.1.4",
  "description": "Heuristic scorer and AI provider integrations (OpenAI, Claude) for SmartLocator AI",
  "license": "MIT",
  "keywords": [
    "smartlocator",
    "ai",
    "openai",
    "claude",
    "selector",
    "test-automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mshakil/ai-smart-selector.git",
    "directory": "packages/ai-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@smartlocator/shared": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "openai": "^4.52.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
